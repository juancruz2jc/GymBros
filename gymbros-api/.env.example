# Copiar a .env y ajustar. El .env NO se sube al repositorio.

# --- Base de datos ---
# Activa UNA sola DATABASE_URL.
#
# Por defecto: base compartida del equipo (Supabase, Session Pooler).
# `docker compose up` levanta solo la API contra esta base.
# Si la contraseña tiene caracteres especiales (@ : / # ? %), hay que
# codificarlos en la URL: p. ej. @ -> %40, # -> %23.
DATABASE_URL=postgresql+psycopg2://postgres.nzzletejrnesxlsrnmxf:[CONTRASEÑA_DE_SUPABASE]@aws-0-sa-east-1.pooler.supabase.com:5432/postgres?sslmode=require

# Local con Docker, para pruebas destructivas o trabajar sin conexión.
# Requiere `docker compose --profile local up`:
# DATABASE_URL=postgresql+psycopg2://gymbros:gymbros@db:5432/gymbros

# Local sin Docker (PostgreSQL instalado en tu máquina):
# DATABASE_URL=postgresql+psycopg2://gymbros:gymbros@localhost:5432/gymbros

# Conexiones por instancia de la API. El pooler de Supabase las comparte entre
# todo el equipo: no subir sin coordinarlo.
DB_POOL_SIZE=3
DB_MAX_OVERFLOW=2

# --- Seguridad ---
# Generar con: python -c "import secrets; print(secrets.token_urlsafe(32))"
JWT_SECRET=cambiar-por-un-valor-aleatorio
JWT_ALGORITHM=HS256
ACCESS_TOKEN_MINUTOS=15
REFRESH_TOKEN_DIAS=30
# Reservada para recuperación de contraseña (RN-27); todavía no la lee ningún código.
RECUPERACION_TOKEN_MINUTOS=60
