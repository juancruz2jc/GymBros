# Copiar a .env y ajustar. El .env NO se sube al repositorio.

# --- Base de datos ---
# Credenciales del contenedor de PostgreSQL (las lee docker-compose). Solo se
# aplican la primera vez que se crea el volumen; si las cambias después, hay
# que hacer `docker compose down -v` para que tomen efecto.
POSTGRES_USER=gymbros
POSTGRES_PASSWORD=gymbros
POSTGRES_DB=gymbros

# URL que usa la API. Debe coincidir con las tres variables de arriba.
# Con Docker (el host es el nombre del servicio en docker-compose):
DATABASE_URL=postgresql+psycopg2://gymbros:gymbros@db:5432/gymbros
# Sin Docker, con PostgreSQL local, usar en su lugar:
# DATABASE_URL=postgresql+psycopg2://gymbros:gymbros@localhost:5432/gymbros

# --- Seguridad ---
# Generar con: python -c "import secrets; print(secrets.token_urlsafe(32))"
JWT_SECRET=cambiar-por-un-valor-aleatorio
JWT_ALGORITHM=HS256
ACCESS_TOKEN_MINUTOS=15
REFRESH_TOKEN_DIAS=30
# Reservada para recuperación de contraseña (RN-27); todavía no la lee ningún código.
RECUPERACION_TOKEN_MINUTOS=60