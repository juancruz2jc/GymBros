# Variables de docker compose (raíz del repo). Copiar a .env y ajustar.
# Las de la API (base, JWT) van aparte, en gymbros-api/.env.

# Nombre del proyecto en docker: prefija contenedores, red e imágenes.
# En el VPS compartido debe ser único, p. ej. gymbros-d-equipo-1.
COMPOSE_PROJECT_NAME=gymbros

# Puertos del host (solo escuchan en 127.0.0.1; afuera se entra por nginx).
# En el VPS elegir puertos libres: ss -tlnp | grep -E ':80[0-9]{2}'
API_PORT=8001
LANDING_PORT=8002
